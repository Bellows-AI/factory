{
    "$schema": "https://opencode.ai/config.json",
    "instructions": ["/home/node/.config/opencode/AGENTS.md"],
    "disabled_providers": ["github-copilot"],
    "plugin": [
        "/usr/local/lib/node_modules/@gcornut/opencode-otel",
        "/usr/local/lib/node_modules/context-mode"
    ],
    "permission": {
        "*": "allow",
        "read": {
            "*": "allow"
        },
        "webfetch": "deny",
        "bash": {
            "*": "allow",
            "git switch": "deny",
            "git switch *": "deny",
            "git checkout": "deny",
            "git checkout *": "deny",
            "git worktree": "deny",
            "git worktree *": "deny",
            "git branch -d*": "deny",
            "git branch -D*": "deny",
            "git branch -m*": "deny",
            "git branch -M*": "deny",
            "git branch -c*": "deny",
            "git branch -C*": "deny",
            "git branch -f*": "deny",
            "git branch --delete*": "deny",
            "git branch --force*": "deny",
            "git branch --move*": "deny",
            "git branch --copy*": "deny",
            "git reset --hard": "deny",
            "git reset --hard *": "deny",
            "git rebase": "deny",
            "git rebase *": "deny",
            "git merge": "deny",
            "git merge *": "deny",
            "git worktree list": "allow",
            "git rebase --abort": "allow",
            "git rebase --quit": "allow",
            "git rebase --continue": "allow",
            "git merge --abort": "allow",
            "git merge --quit": "allow"
        },
        "external_directory": {
            "*": "deny",
            "/tmp/*": "allow",
            "/home/node/*": "allow"
        }
    }
}
