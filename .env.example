# The only way to configure this: environment variables. Copy to .env (gitignored) and fill in;
# it is loaded via --env-file-if-exists before any application code runs, so anything set here
# behaves as ordinary environment.

# --- The repo-read credential, and the repo list ---------------------------------------------
#
# Both come from one GitHub App installation. Register an App, give it the three read permissions
# below, install it on the org whose repositories you want measured, and generate a private key.
#
#   Metadata: read
#   Pull requests: read
#   Contents: read   <- only for the revert rate; without it that one metric reports "unavailable"
#
# There is no mode to select: every deployment fetches through the App, so both keys below are
# required and either one missing is fatal and says which one. The offline tooling (`npm run
# seed`, `npm run verify:ui`, `npm run test:jobs`) runs without a credential by booting the
# code-only no-fetch entry (`server/dist/offline.js`) — not by any environment variable.
#
# GITHUB_TOKEN, GITHUB_OWNER and ORG_REPOS are all FATAL rather than ignored: each used to decide
# what the page was made of, so a quietly dropped one would boot a dashboard whose operator
# believes it is reading something else.

GITHUB_APP_ID=

# The contents of the .pem GitHub gave you, or its base64 — one line survives a .env file, a PEM
# does not. Or leave this empty and point the next line at the file.
#
# This is the worst secret in this repository to leak: it mints installation tokens indefinitely,
# and rotating it means generating a new key in GitHub's UI.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=

# Where members' checkouts live: one clone per repo each person selected, at
# `<root>/<org id>/<user id>/<repo name>` — the org id is the installation id. Absolute, or starting with "~/"; a relative path is
# rejected rather than resolved. Unset means nothing is cloned and the Workspace page says so.
#
# docker-compose.yml defaults this to /workspaces and mounts a named volume there. Nothing is
# cloned until somebody signs in and picks repositories — boot itself checks nothing out.
#
# Only ever adds: an existing checkout is never fetched or overwritten, and deselecting a repo
# leaves its directory behind.
ORG_WORKSPACE_ROOT=

# REQUIRED. The database is the only source the dashboard reads.
DATABASE_URL=postgres://factory:factory@127.0.0.1:5432/factory_dev

PORT=8080
HOST=127.0.0.1

# Retired variables — BASE_BRANCH, SYNC_TTL_SECONDS, BOTS and CACHE_TTL_SECONDS — are fatal if
# set, not ignored: each used to decide what the page was made of, so an ignored one would boot a
# dashboard whose operator believes it is reading something else.

# --- Authentication ------------------------------------------------------------------------
#
# `none` (the default) means no application-level auth at all: every route is open to anyone who
# can reach the port, including POST /api/jobs, which runs shell commands. `github` requires a
# signed-in member. An EXPLICIT enum — setting a client id and forgetting this leaves the
# deployment open rather than half-enabled. See docs/auth.md.
#
# Read by `npm run dev` and the CLIs. `docker compose` ignores it and pins `github`, so the four
# keys below are REQUIRED to bring that stack up at all — a missing one is fatal and names itself.
AUTH_MODE=none

# Register an OAuth App — a SECOND registration, separate from the GitHub App above — with the
# callback set to <PUBLIC_URL>/api/auth/github/callback. No scopes are requested: membership is
# Factory's, not GitHub's. Two registrations on purpose: signing somebody in needs no scopes at
# all, while reading repositories needs installation permissions, and one credential doing both
# would mean every person who signs in grants repository access.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# At least 32 characters. Signs the session cookie, so rotating it logs everyone out.
SESSION_SECRET=

# The absolute origin GitHub redirects back to. Defaults to http://<HOST>:<PORT> for a loopback
# bind and is REQUIRED otherwise — it cannot be derived from the request's Host header without
# letting the caller choose the redirect target.
PUBLIC_URL=

# Whether the session cookie carries `Secure`. Leave off for http://127.0.0.1; turn it on behind
# TLS. Not derived from the request, because that means trusting X-Forwarded-Proto from anyone.
COOKIE_SECURE=0

# Membership is the App's installations now (#99): anyone who can see an installation signs in,
# and the orgs materialize at sign-in. Set the App's SETUP URL to
# <PUBLIC_URL>/api/auth/github/setup so the install round trip returns. For a legacy database,
# re-home its history with: npm run adopt -- --installation <id>
#
# Optional shared secret for the telemetry ingest routes, sent as X-Factory-Ingest-Token. Unset
# leaves them open, which is what the collector and the laptop plugin expect today.
INGEST_TOKEN=

# HMAC secret for the App's installation webhook — App settings → webhook URL
# <PUBLIC_URL>/api/github/webhook, secret = this value, subscribed to `organization` events. Unset,
# the route is absent and a GitHub-side removal waits for the removed account's next sign-in.
GITHUB_WEBHOOK_SECRET=

# Only needed if AUTH_MODE=none has to run on a HOST that is not loopback — it asserts that
# something in front of this port is doing the authenticating. docker-compose.yml sets it because
# the image binds 0.0.0.0 and the isolation is compose's 127.0.0.1 publish.
AUTH_ALLOW_PUBLIC_BIND=

# The driver's credential against a board running AUTH_MODE=github — one per organization (#99),
# where the org is the installation id sign-in created.
# Mint with: npm run worker-token -- --org <installation-id> --name driver-1
JOB_BOARD_TOKEN=
