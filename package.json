{
    "name": "factory-ai",
    "private": true,
    "type": "module",
    "workspaces": [
        "core",
        "server",
        "web",
        "driver"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "npm run build -w core && npm run build -w server && npm run build -w web && npm run build -w driver",
        "dev": "npm run build -w core && concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
        "dev:server": "npm run dev -w server",
        "dev:web": "npm run dev -w web",
        "driver": "npm run dev -w driver",
        "start": "node --env-file-if-exists=.env server/dist/index.js",
        "pretest": "npm run build -w core",
        "test": "vitest run",
        "pretest:executors": "npm run build -w core",
        "test:executors": "vitest run --config vitest.executors.config.ts",
        "pretest:coverage:executors": "npm run build -w core",
        "test:coverage:executors": "vitest run --config vitest.executors.config.ts --coverage",
        "pretest:db": "npm run build -w core",
        "test:db": "vitest run --config vitest.db.config.ts",
        "test:jobs": "bash scripts/test-jobs.sh",
        "test:k8s": "bash scripts/test-k8s.sh",
        "verify:ui": "playwright test",
        "typecheck": "tsc -b",
        "lint": "biome check .",
        "format": "biome format --write .",
        "lint:fix": "biome check --write .",
        "backfill": "npm run build -w core && npm run build -w server && node server/dist/backfill/cli.js",
        "seed": "npm run build -w core && npm run build -w server && node server/dist/seed/cli.js"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@playwright/test": "1.62.1",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^3.2.7",
        "concurrently": "^9.1.2",
        "postgres": "3.4.9",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0",
        "yaml": "2.9.1"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "esbuild@0.25.12": true
    }
}
